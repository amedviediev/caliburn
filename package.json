{
  "private": true,
  "name": "caliburn-monorepo",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "caliburn-app",
    "packages/*"
  ],
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@angular/build": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/compiler-cli": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@babel/preset-env": "7.26.9",
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/socket.io-client": "3.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "chai": "4.3.6",
    "dotenv": "16.0.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "http-server": "14.1.1",
    "husky": "7.0.4",
    "jsdom": "22.1.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "puppeteer-core": "25.7.0",
    "rewire": "6.0.0",
    "rimraf": "^5.0.0",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vite": "^6.3.5",
    "vitest": "3.2.7",
    "vitest-canvas-mock": "0.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": ".",
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build-node": "node ./scripts/build-node.js",
    "build:common": "yarn --cwd ./packages/common build:esm",
    "build:caliburn": "yarn --cwd ./packages/caliburn build",
    "build:element": "yarn --cwd ./packages/element build:esm",
    "build:excalidraw": "yarn --cwd ./packages/excalidraw build:esm",
    "build:math": "yarn --cwd ./packages/math build:esm",
    "build:utils": "yarn --cwd ./packages/utils build:esm",
    "build:fractional-indexing": "yarn --cwd ./packages/fractional-indexing build:esm",
    "build:laser-pointer": "yarn --cwd ./packages/laser-pointer build:esm",
    "build:packages": "yarn build:common && yarn build:fractional-indexing && yarn build:laser-pointer && yarn build:math && yarn build:element && yarn build:utils && yarn build:excalidraw && yarn build:caliburn",
    "test:all": "yarn test:typecheck && yarn test:code && yarn test:other && yarn test:app --watch=false",
    "test:app": "vitest",
    "test:code": "eslint --max-warnings=0 --ext .js,.mjs,.ts,.tsx .",
    "test:other": "yarn prettier --list-different",
    "test:typecheck": "tsc",
    "test:update": "yarn test:app --update --watch=false",
    "test": "yarn test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "yarn test --ui --coverage.enabled=true",
    "fix:code": "yarn test:code --fix",
    "fix:other": "yarn prettier --write",
    "fix": "yarn fix:other && yarn fix:code",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "rm:build": "rimraf --glob packages/*/dist packages/*/build",
    "rm:node_modules": "rimraf --glob node_modules packages/*/node_modules",
    "clean-install": "yarn rm:node_modules && yarn install",
    "demo": "vite --config examples/with-vite/vite.config.mts",
    "demo:build": "vite build --config examples/with-vite/vite.config.mts",
    "e2e": "node e2e/run.mjs",
    "start": "vite --config caliburn-app/vite.config.mts"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  }
}
