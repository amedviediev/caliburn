exports[`Test <MermaidToExcalidraw/> > should open mermaid popup when active tool is mermaid 1`] = `"<caliburn-modal role="dialog" aria-modal="true" labelledby="dialog-title" aria-labelledby="dialog-title" class="Dialog Modal ttd-dialog"><div class="Modal__background"></div><div tabindex="0" class="Modal__content" style="--max-width: 1520px;"><caliburn-island class="Island"><!--container--><!--container--><div class="Dialog__content"><div class="ttd-dialog-tabs-root"><p class="dialog-mermaid-title">Mermaid to Excalidraw</p><div class="ttd-dialog-content"><caliburn-mermaid-to-excalidraw><div class="ttd-dialog-desc"><!--container-->Currently only <!--container--><a target="_blank" rel="noreferrer" href="https://mermaid.js.org/syntax/flowchart.html">Flowchart</a><!--container--><!--container--><!--container-->, <!--container--><a target="_blank" rel="noreferrer" href="https://mermaid.js.org/syntax/sequenceDiagram.html">Sequence</a><!--container--><!--container--><!--container-->, <!--container--><a target="_blank" rel="noreferrer" href="https://mermaid.js.org/syntax/classDiagram.html">Class</a><!--container--><!--container--><!--container-->, and <!--container--><a target="_blank" rel="noreferrer" href="https://mermaid.js.org/syntax/entityRelationshipDiagram.html">Entity Relationship</a><!--container--><!--container--><!--container--> Diagrams are supported. The other types will be rendered as image in Excalidraw.<!--container--><!--container--></div><div class="ttd-dialog-panels"><div class="ttd-dialog-panel"><textarea class="ttd-dialog-input" placeholder="Write Mermaid diagram defintion here..."></textarea><div class="ttd-dialog-panel-button-container invisible" style="justify-content: flex-start;"></div></div><div class="ttd-dialog-panel"><caliburn-ttd-dialog-output><div class="ttd-dialog-output-wrapper"><!--container--><div class="ttd-dialog-output-canvas-container"><div class="ttd-dialog-output-canvas-content"><canvas width="89" height="158" dir="ltr"></canvas></div></div><!--container--><!--container--></div></caliburn-ttd-dialog-output><div class="ttd-dialog-panel-button-container" style="justify-content: flex-start;"><button caliburn-button="" class="ttd-dialog-panel-button excalidraw-button" type="button"><div> Insert<span><ng-icon role="img" name="arrowRightIcon" _nghost-a-c572653062="" aria-hidden="true"><svg aria-hidden="true" focusable="false" role="img" viewBox="0 0 20 20" class="" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><g stroke-width="1.25"><path d="M4.16602 10H15.8327"></path><path d="M12.5 13.3333L15.8333 10"></path><path d="M12.5 6.66666L15.8333 9.99999"></path></g></svg></ng-icon></span></div></button><div class="ttd-dialog-submit-shortcut"><div class="ttd-dialog-submit-shortcut__key">Ctrl</div><div class="ttd-dialog-submit-shortcut__key">Enter</div></div></div></div></div></caliburn-mermaid-to-excalidraw></div></div></div></caliburn-island></div></caliburn-modal>"`;

exports[`Test <MermaidToExcalidraw/> > should show error in preview when mermaid library throws error 1`] = `
"flowchart TD
 A[Christmas] -->|Get money| B(Go shopping)
 B --> C{Let me think}
 C -->|One| D[Laptop]
 C -->|Two| E[iPhone]
 C -->|Three| F[Car]"
`;
