exports[`<Excalidraw/> > <MainMenu/> > should render main menu with host menu items if passed from host 1`] = `
<div
  class="dropdown-menu main-menu"
  data-testid="dropdown-menu"
  style="position: fixed; top: 8px; left: 0px;"
>
  <!--container-->
  <caliburn-island
    class="Island dropdown-menu-container"
    style="--padding: 2;"
  >
    <button
      caliburn-dropdown-menu-item=""
      class="dropdown-menu-item dropdown-menu-item-base"
      type="button"
    >
      <caliburn-dropdown-menu-item-content
        style="display: contents;"
      >
        <!--container-->
        <div
          class="dropdown-menu-item__text"
          style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"
        >
           Click me 
        </div>
        <!--container-->
        <!--container-->
      </caliburn-dropdown-menu-item-content>
    </button>
    <a
      caliburn-dropdown-menu-item-link=""
      class="dropdown-menu-item dropdown-menu-item-base"
      href="blog.excalidaw.com"
      rel="noopener noopener"
