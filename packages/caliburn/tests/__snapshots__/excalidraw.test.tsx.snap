        >
          <div
            class="dropdown-menu-item__icon"
          >
            <ng-icon
              _nghost-a-c572653062=""
              aria-hidden="true"
              role="img"
            >
              <svg
                aria-hidden="true"
                class=""
                fill="none"
                focusable="false"
                role="img"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <g
                  stroke-width="1.5"
